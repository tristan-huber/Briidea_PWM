        },
        {
          "atomType": "Code",
          "x": 0.7,
          "y": 0.4,
          "uniqueID": "id-136199",
          "ioValues": [
            {
              "name": "surface",
              "ioValue": "__GEOMETRY_INPUT__"
            },
            {
              "name": "asSingular",
              "ioValue": true
            }
          ],
          "interpreterVersion": 1,
          "code": "// eslint-disable-next-line @typescript-eslint/no-unused-vars\nfunction run(\n  surface: Assembly,\n  asSingular: boolean): Assembly {\n  const toUnroll: { srcLeaf: Assembly, mesh: Mesh }[] = [];\n  surface.onLeafs((leaf) => {\n    const sface = leaf.getSelectedFaces().filter((f) => f != undefined);\n    if (sface.length > 0) {\n      toUnroll.push(...sface.map((f) => { return { srcLeaf: leaf, mesh: faceToMesh(f) }; }))\n    } else if (leaf.geometry instanceof replicad.Face) {\n      toUnroll.push({ srcLeaf: leaf, mesh: faceToMesh(leaf.geometry) })\n    }\n    return leaf;\n  });\n  if (toUnroll.length == 0) {\n    throw new Error(\"No selected faces, and not an assembly of face geoms\")\n  }\n\n  if (asSingular) {\n    // combine meshes first, then unroll\n    const foo = toUnroll.reduce((accumulator: Mesh, curr) => {\n      return combineMeshs(accumulator, curr.mesh)\n    }, { positions: [], tris: [] })\n    const unrolled = unrollArap(foo)\n    return new Assembly({\n      geometry: xysToClosedDrawing(unrolled.outline)\n    })\n\n  } else {\n    //@ts-ignore\n    const result = toUnroll.map((leaf) => {\n      const unrollResult = unrollArap(leaf.mesh)\n      return new Assembly({\n        ...leaf.srcLeaf,\n        geometry: xysToClosedDrawing(unrollResult.outline)\n      })\n    })\n    return new Assembly({ geometry: result.flat() }).skipDisjointPostprocess();\n  }\n}\n\nfunction combineMeshs(m1: Mesh, m2: Mesh): Mesh {\n  console.log(`m1, position count: ${m1.positions.length} tris count: ${m1.tris.length}`)\n  console.log(`m2, position count: ${m2.positions.length} tris count: ${m2.tris.length}`)\n  const floatEq = (a: number,b: number) => {\n    return Math.abs(a - b) < 0.000001\n  }\n\n  // find match points TODO this is deeply suboptimal. Esp if combineMeshs is called more than once.\n  const indexTuples: {m1: number, m2: number}[] = []\n  m1.positions.forEach((point, index) => {\n    m2.positions.forEach((p2, i2) => {\n      if (floatEq(point.x, p2.x) && floatEq(point.y, p2.y) && floatEq(point.z, p2.z)) {\n        console.log('found a match')\n        indexTuples.push({m1: index, m2: i2})\n      }\n    })\n  })\n  console.log(indexTuples)\n  \n  const shiftTris = m2.tris.map((tri) => {\n    return tri.map((pointIndex) => pointIndex += m1.positions.length) as Tri3\n  })\n  // replace equivalent points from meshes\n  const dedupTris = shiftTris.map((tri) => {\n    return tri.map((pointIndex) => {\n      const unshift = pointIndex - m1.positions.length;\n      const i = indexTuples.map((f) => f.m2).indexOf(unshift)\n      if (i >= 0) {\n        return indexTuples[i].m1\n      }\n      return pointIndex\n    }) as Tri3\n  })\n  const res =  {\n    positions: m1.positions.concat(m2.positions),\n    tris: m1.tris.concat(dedupTris)\n  }\n  console.log(`res, position count: ${res.positions.length} tris count: ${res.tris.length}`)\n  return res;\n}\n\nfunction faceToMesh(face: replicad.Face): Mesh {\n  const replMesh = face.mesh();\n  // translate\n  const points: Point3D[] = []\n  const v = replMesh.vertices\n  for (let i = 0; i < v.length; i += 3) {\n    points.push({ x: v[i], y: v[i + 1], z: v[i + 2] })\n  }\n  const tris: Tri3[] = []\n  const t = replMesh.triangles\n  for (let i = 0; i < t.length; i += 3) {\n    tris.push([t[i], t[i + 1], t[i + 2]])\n  }\n  return { positions: points, tris: tris }\n}\n\nfunction xysToClosedDrawing(points: Point2D[]) {\n  const pen = replicad.draw([points[0].x, points[0].y]);\n  for (let i = 1; i < points.length; i++) {\n    pen.lineTo([points[i].x, points[i].y]);\n  }\n  return pen.close();\n}\n\n\n\nexport type Point2D = { x: number; y: number }\nexport type Point3D = { x: number; y: number; z: number }\n\nexport type Tri3 = [number, number, number]\n\nexport type Mesh = {\n  positions: Point3D[]\n  tris: Tri3[]\n}\n\nexport type FlatMesh = {\n  positions: Point2D[]\n  outline: Point2D[]\n}\n\nexport type Unroller = (mesh: Mesh) => FlatMesh\n\nconst COT_MIN = 0.05\nconst COT_MAX = 20\n\nconst ITERATIONS = 4000\n\nconst SETTLED = 1e-6\n\ntype Adj = { j: number; w: number; t: number; dx: number; dy: number }\n\nexport function unrollArap(mesh: Mesh): FlatMesh {\n  const tris = buildTris(mesh)\n  const nv = mesh.positions.length\n  const flat = placeByUnfolding(mesh, tris)\n  console.log(flat)\n\n  if (tris.length > 0 && nv > 1) {\n    const { adj, triW } = buildAdjacency(tris, nv)\n    solve(flat, tris, adj, triW)\n  }\n\n  const positions = canonicalise(flat)\n  return { positions, outline: boundaryLoop(mesh).map((i) => positions[i]) }\n}\n\nfunction buildAdjacency(\n  tris: Tri[],\n  nv: number,\n): { adj: Adj[][]; triW: Float64Array } {\n  const adj: Adj[][] = []\n  const triW = new Float64Array(tris.length * 3)\n  for (let i = 0; i < nv; i++) adj.push([])\n\n  tris.forEach((tri, t) => {\n    const { ids, xs } = tri\n    const twoArea = 2 * tri.area\n    for (let e = 0; e < 3; e++) {\n      const p = e\n      const q = (e + 1) % 3\n      const o = (e + 2) % 3\n      const ax = xs[p].x - xs[o].x, ay = xs[p].y - xs[o].y\n      const bx = xs[q].x - xs[o].x, by = xs[q].y - xs[o].y\n\n      const cot = twoArea > 0 ? (ax * bx + ay * by) / twoArea : COT_MIN\n      const w = Math.min(COT_MAX, Math.max(COT_MIN, cot))\n      triW[t * 3 + e] = w\n      const dx = xs[p].x - xs[q].x\n      const dy = xs[p].y - xs[q].y\n      adj[ids[p]].push({ j: ids[q], w, t, dx, dy })\n      adj[ids[q]].push({ j: ids[p], w, t, dx: -dx, dy: -dy })\n    }\n  })\n  return { adj, triW }\n}\n\nfunction solve(flat: Point2D[], tris: Tri[], adj: Adj[][], triW: Float64Array) {\n  const nv = flat.length\n  const cos = new Float64Array(tris.length)\n  const sin = new Float64Array(tris.length)\n  const tol = SETTLED * intrinsicScale(tris)\n  const system = factorSystem(adj, nv)\n\n  const bestX = new Float64Array(nv)\n  const bestY = new Float64Array(nv)\n  let bestE = energyOf(flat, tris)\n  snapshot(flat, bestX, bestY)\n\n  const rx = new Float64Array(Math.max(nv - 1, 0))\n  const ry = new Float64Array(Math.max(nv - 1, 0))\n\n  for (let it = 0; it < ITERATIONS; it++) {\n    localStep(flat, tris, triW, cos, sin)\n\n    let maxDelta = 0\n    if (system) {\n      rx.fill(0)\n      ry.fill(0)\n      for (let i = 1; i < nv; i++) {\n        let bx = 0\n        let by = 0\n        for (const e of adj[i]) {\n          bx += e.w * (cos[e.t] * e.dx - sin[e.t] * e.dy)\n          by += e.w * (sin[e.t] * e.dx + cos[e.t] * e.dy)\n          if (e.j === 0) {\n            bx += e.w * flat[0].x\n            by += e.w * flat[0].y\n          }\n        }\n        rx[i - 1] = bx\n        ry[i - 1] = by\n      }\n      solveBanded(system, rx, ry)\n      for (let i = 1; i < nv; i++) {\n        const d = Math.hypot(rx[i - 1] - flat[i].x, ry[i - 1] - flat[i].y)\n        if (d > maxDelta) maxDelta = d\n        flat[i].x = rx[i - 1]\n        flat[i].y = ry[i - 1]\n      }\n    } else {\n      maxDelta = gaussSeidel(flat, adj, cos, sin, nv)\n    }\n\n    const e = energyOf(flat, tris)\n    if (e < bestE) {\n      bestE = e\n      snapshot(flat, bestX, bestY)\n    }\n    if (maxDelta < tol) break\n  }\n\n  restore(flat, bestX, bestY)\n}\n\nfunction snapshot(flat: Point2D[], x: Float64Array, y: Float64Array) {\n  for (let i = 0; i < flat.length; i++) {\n    if (flat[i] == undefined) {\n      continue;\n    }\n    x[i] = flat[i].x\n    y[i] = flat[i].y\n  }\n}\n\nfunction restore(flat: Point2D[], x: Float64Array, y: Float64Array) {\n  for (let i = 0; i < flat.length; i++) {\n    flat[i] = { x: x[i], y: y[i] }\n  }\n}\n\nfunction localStep(\n  flat: Point2D[],\n  tris: Tri[],\n  triW: Float64Array,\n  cos: Float64Array,\n  sin: Float64Array,\n) {\n  tris.forEach((tri, t) => {\n    const { ids, xs } = tri\n    let num = 0\n    let den = 0\n    for (let e = 0; e < 3; e++) {\n      const p = e\n      const q = (e + 1) % 3\n      const w = triW[t * 3 + e]\n      const dxc = xs[q].x - xs[p].x\n      const dyc = xs[q].y - xs[p].y\n      const dqx = flat[ids[q]].x - flat[ids[p]].x\n      const dqy = flat[ids[q]].y - flat[ids[p]].y\n      num += w * (dqy * dxc - dqx * dyc)\n      den += w * (dqx * dxc + dqy * dyc)\n    }\n    const th = Math.atan2(num, den)\n    cos[t] = Math.cos(th)\n    sin[t] = Math.sin(th)\n  })\n}\n\nfunction gaussSeidel(\n  flat: Point2D[],\n  adj: Adj[][],\n  cos: Float64Array,\n  sin: Float64Array,\n  nv: number,\n): number {\n  let maxDelta = 0\n  for (let sweep = 0; sweep < 3; sweep++) {\n    for (let i = 1; i < nv; i++) {\n      let diag = 0\n      let sx = 0\n      let sy = 0\n      for (const e of adj[i]) {\n        diag += e.w\n        sx += e.w * (flat[e.j].x + cos[e.t] * e.dx - sin[e.t] * e.dy)\n        sy += e.w * (flat[e.j].y + sin[e.t] * e.dx + cos[e.t] * e.dy)\n      }\n      if (diag <= 0) continue\n      const nx = sx / diag\n      const ny = sy / diag\n      const d = Math.hypot(nx - flat[i].x, ny - flat[i].y)\n      if (d > maxDelta) maxDelta = d\n      flat[i] = { x: nx, y: ny }\n    }\n  }\n  return maxDelta\n}\n\ntype Banded = { n: number; b: number; a: Float64Array; envelope: Int32Array }\n\nfunction factorSystem(adj: Adj[][], nv: number): Banded | null {\n  const n = nv - 1\n  if (n <= 0) return null\n\n  let b = 0\n  for (let i = 1; i < nv; i++) {\n    for (const e of adj[i]) {\n      if (e.j === 0) continue\n      const d = Math.abs(i - e.j)\n      if (d > b) b = d\n    }\n  }\n  if (b >= n) return null\n\n  const a = new Float64Array(n * (b + 1))\n  for (let i = 1; i < nv; i++) {\n    const r = i - 1\n    for (const e of adj[i]) {\n      a[r * (b + 1)] += e.w\n      if (e.j === 0) continue\n      const c = e.j - 1\n      if (c < r) a[r * (b + 1) + (r - c)] -= e.w\n    }\n  }\n\n  const envelope = new Int32Array(n)\n  for (let r = 0; r < n; r++) {\n    const top = Math.min(b, r)\n    for (let k = top; k >= 1; k--) {\n      if (a[r * (b + 1) + k] !== 0) { envelope[r] = k; break }\n    }\n  }\n\n  for (let i = 0; i < n; i++) {\n    const wi = envelope[i]\n    for (let k = wi; k >= 1; k--) {\n      const j = i - k\n      if (j < 0) continue\n      let s = a[i * (b + 1) + k]\n      const top = Math.min(wi - k, envelope[j])\n      for (let m = 1; m <= top; m++) {\n        s -= a[i * (b + 1) + (k + m)] * a[j * (b + 1) + m]\n      }\n      a[i * (b + 1) + k] = s / a[j * (b + 1)]\n    }\n    let d = a[i * (b + 1)]\n    for (let k = 1; k <= wi; k++) {\n      d -= a[i * (b + 1) + k] * a[i * (b + 1) + k]\n    }\n    if (!(d > 0)) return null\n    a[i * (b + 1)] = Math.sqrt(d)\n  }\n  return { n, b, a, envelope }\n}\n\nfunction solveBanded(m: Banded, rx: Float64Array, ry: Float64Array) {\n  const { n, b, a, envelope } = m\n  const w = b + 1\n  for (let i = 0; i < n; i++) {\n    let sx = rx[i]\n    let sy = ry[i]\n    const wi = envelope[i]\n    for (let k = 1; k <= wi; k++) {\n      const v = a[i * w + k]\n      sx -= v * rx[i - k]\n      sy -= v * ry[i - k]\n    }\n    const d = a[i * w]\n    rx[i] = sx / d\n    ry[i] = sy / d\n  }\n  for (let i = n - 1; i >= 0; i--) {\n    const d = a[i * w]\n    const vx = rx[i] / d\n    const vy = ry[i] / d\n    rx[i] = vx\n    ry[i] = vy\n    const wi = envelope[i]\n    for (let k = 1; k <= wi; k++) {\n      const v = a[i * w + k]\n      rx[i - k] -= v * vx\n      ry[i - k] -= v * vy\n    }\n  }\n}\n\nfunction intrinsicScale(tris: Tri[]): number {\n  let area = 0\n  for (const tri of tris) area += tri.area\n  return area > 0 ? Math.sqrt(area) : 1\n}\n\nexport type Tri = {\n  ids: Tri3\n  xs: [Point2D, Point2D, Point2D]\n  area: number\n}\n\nexport function buildTris(mesh: Mesh): Tri[] {\n  const out: Tri[] = []\n  for (const [a, b, c] of mesh.tris) {\n    const A = mesh.positions[a]\n    const B = mesh.positions[b]\n    const C = mesh.positions[c]\n    const ux = B.x - A.x, uy = B.y - A.y, uz = B.z - A.z\n    const vx = C.x - A.x, vy = C.y - A.y, vz = C.z - A.z\n    const cx = uy * vz - uz * vy\n    const cy = uz * vx - ux * vz\n    const cz = ux * vy - uy * vx\n    const cross = Math.hypot(cx, cy, cz)\n    const la = Math.hypot(ux, uy, uz)\n    const lb = Math.hypot(vx, vy, vz)\n    if (la === 0 || lb === 0) continue\n    const cos = Math.max(-1, Math.min(1, (ux * vx + uy * vy + uz * vz) / (la * lb)))\n    out.push({\n      ids: [a, b, c],\n      xs: [\n        { x: 0, y: 0 },\n        { x: la, y: 0 },\n        { x: lb * cos, y: lb * Math.sqrt(Math.max(0, 1 - cos * cos)) },\n      ],\n      area: cross / 2,\n    })\n  }\n  return out\n}\n\nexport function energyOf(flat: Point2D[], tris: Tri[]): number {\n  let e = 0\n  let area = 0\n  for (const tri of tris) {\n    const { ids, xs } = tri\n    for (let k = 0; k < 3; k++) {\n      const p = k\n      const q = (k + 1) % 3\n      const lc = Math.hypot(xs[q].x - xs[p].x, xs[q].y - xs[p].y)\n      const lq = Math.hypot(\n        flat[ids[q]].x - flat[ids[p]].x,\n        flat[ids[q]].y - flat[ids[p]].y,\n      )\n      e += (lq - lc) * (lq - lc)\n    }\n    area += tri.area\n  }\n  return area > 0 ? e / area : 0\n}\n\nexport function placeByUnfolding(mesh: Mesh, tris: Tri[]): Point2D[] {\n  const nv = mesh.positions.length\n  const flat: Point2D[] = new Array(nv)\n  const placed: boolean[] = new Array(nv).fill(false)\n\n  const incident: number[][] = []\n  for (let i = 0; i < nv; i++) incident.push([])\n  tris.forEach((tri, t) => {\n    for (const id of tri.ids) incident[id].push(t)\n  })\n\n  const seed = tris[0]\n  seed.ids.forEach((id, k) => {\n    flat[id] = { x: seed.xs[k].x, y: seed.xs[k].y }\n    placed[id] = true\n  })\n\n  const queue: number[] = seed.ids.flatMap((id) => incident[id])\n  for (let head = 0; head < queue.length; head++) {\n    const tri = tris[queue[head]]\n    const open = tri.ids.filter((i) => !placed[i])\n    if (open.length !== 1) continue\n    const v = open[0]\n    const p = placeFrom(bestHinge(v, incident[v], tris, placed, tri), v, flat, placed)\n    if (!p) continue\n    flat[v] = p\n    placed[v] = true\n    for (const t of incident[v]) queue.push(t)\n  }\n\n  for (let i = 0; i < nv; i++) {\n    if (!placed[i]) console.warn(`unroll: vertex ${i} of ${nv} is not connected to the mesh`)\n  }\n  return flat\n}\n\nfunction bestHinge(\n  v: number,\n  candidates: number[],\n  tris: Tri[],\n  placed: boolean[],\n  fallback: Tri,\n): Tri {\n  let best = fallback\n  let bestScore = -Infinity\n  for (const t of candidates) {\n    const tri = tris[t]\n    const k = tri.ids.indexOf(v)\n    if (k < 0) continue\n    const i = (k + 1) % 3\n    const j = (k + 2) % 3\n    if (!placed[tri.ids[i]] || !placed[tri.ids[j]]) continue\n    const edge = sq(tri.xs[j].x - tri.xs[i].x, tri.xs[j].y - tri.xs[i].y)\n    const reach = sq(tri.xs[k].x - tri.xs[i].x, tri.xs[k].y - tri.xs[i].y)\n    const score = reach > 0 ? edge / reach : Infinity\n    if (score > bestScore) {\n      bestScore = score\n      best = tri\n    }\n  }\n  return best\n}\n\nfunction sq(dx: number, dy: number): number {\n  return dx * dx + dy * dy\n}\n\nfunction placeFrom(\n  tri: Tri,\n  v: number,\n  flat: Point2D[],\n  placed: boolean[],\n): Point2D | null {\n  const { ids, xs } = tri\n  const k = ids.indexOf(v)\n  const i = (k + 1) % 3\n  const j = (k + 2) % 3\n  if (!placed[ids[i]] || !placed[ids[j]]) return null\n\n  const dx = xs[j].x - xs[i].x\n  const dy = xs[j].y - xs[i].y\n  const den = dx * dx + dy * dy\n  if (den < 1e-12) return null\n  const ex = flat[ids[j]].x - flat[ids[i]].x\n  const ey = flat[ids[j]].y - flat[ids[i]].y\n  const sr = (ex * dx + ey * dy) / den\n  const si = (ey * dx - ex * dy) / den\n  const norm = Math.hypot(sr, si)\n  if (norm < 1e-12) return null\n  const cr = sr / norm\n  const ci = si / norm\n  const vx = xs[k].x - xs[i].x\n  const vy = xs[k].y - xs[i].y\n  return {\n    x: flat[ids[i]].x + cr * vx - ci * vy,\n    y: flat[ids[i]].y + ci * vx + cr * vy,\n  }\n}\n\nexport function canonicalise(flat: Point2D[]): Point2D[] {\n  if (flat.length === 0) return flat\n  let cx = 0\n  let cy = 0\n  for (const p of flat) {\n    cx += p.x\n    cy += p.y\n  }\n  cx /= flat.length\n  cy /= flat.length\n\n  let sxx = 0\n  let sxy = 0\n  let syy = 0\n  for (const p of flat) {\n    const dx = p.x - cx\n    const dy = p.y - cy\n    sxx += dx * dx\n    sxy += dx * dy\n    syy += dy * dy\n  }\n  const ang = 0.5 * Math.atan2(2 * sxy, sxx - syy)\n  const co = Math.cos(-ang)\n  const si = Math.sin(-ang)\n\n  let minX = Infinity\n  let minY = Infinity\n  const out = flat.map((p) => {\n    const dx = p.x - cx\n    const dy = p.y - cy\n    const q = { x: co * dx - si * dy, y: si * dx + co * dy }\n    if (q.x < minX) minX = q.x\n    if (q.y < minY) minY = q.y\n    return q\n  })\n  for (const q of out) {\n    q.x -= minX\n    q.y -= minY\n  }\n  return out\n}\n\nexport function boundaryEdges(mesh: Mesh): [number, number][] {\n  const used = new Map<string, number>()\n  const key = (a: number, b: number) => (a < b ? `${a}-${b}` : `${b}-${a}`)\n\n  for (const [a, b, c] of mesh.tris) {\n    for (const [u, v] of [[a, b], [b, c], [c, a]]) {\n      used.set(key(u, v), (used.get(key(u, v)) ?? 0) + 1)\n    }\n  }\n\n  const out: [number, number][] = []\n  for (const [a, b, c] of mesh.tris) {\n    for (const [u, v] of [[a, b], [b, c], [c, a]] as [number, number][]) {\n      if (used.get(key(u, v)) === 1) out.push([u, v])\n    }\n  }\n  return out\n}\n\nexport function chainEdges(edges: [number, number][]): number[][] {\n  const next = new Map<number, number>()\n  const hasPredecessor = new Set<number>()\n  for (const [u, v] of edges) {\n    next.set(u, v)\n    hasPredecessor.add(v)\n  }\n\n  const chains: number[][] = []\n  const visited = new Set<number>()\n\n  const walk = (seed: number) => {\n    const chain = [seed]\n    visited.add(seed)\n    let cur = seed\n    while (true) {\n      const to = next.get(cur)\n      if (to === undefined || to === seed) break\n      if (visited.has(to)) break\n      chain.push(to)\n      visited.add(to)\n      cur = to\n    }\n\n    if (next.get(cur) === seed && chain.length > 2) chain.push(seed)\n    if (chain.length > 1) chains.push(chain)\n  }\n\n  for (const [u] of next) if (!hasPredecessor.has(u)) walk(u)\n  for (const [u] of next) if (!visited.has(u)) walk(u)\n  return chains\n}\n\nexport function boundaryLoop(mesh: Mesh): number[] {\n  const chains = chainEdges(boundaryEdges(mesh))\n  if (chains.length === 0) return []\n  const loop = chains[0]\n  return loop[0] === loop[loop.length - 1] ? loop.slice(0, -1) : loop\n}\n",
          "compiledCode": "// eslint-disable-next-line @typescript-eslint/no-unused-vars\nfunction run(surface, asSingular) {\n    const toUnroll = [];\n    surface.onLeafs((leaf) => {\n        const sface = leaf.getSelectedFaces().filter((f) => f != undefined);\n        if (sface.length > 0) {\n            toUnroll.push(...sface.map((f) => { return { srcLeaf: leaf, mesh: faceToMesh(f) }; }));\n        }\n        else if (leaf.geometry instanceof replicad.Face) {\n            toUnroll.push({ srcLeaf: leaf, mesh: faceToMesh(leaf.geometry) });\n        }\n        return leaf;\n    });\n    if (toUnroll.length == 0) {\n        throw new Error(\"No selected faces, and not an assembly of face geoms\");\n    }\n    if (asSingular) {\n        // combine meshes first, then unroll\n        const foo = toUnroll.reduce((accumulator, curr) => {\n            return combineMeshs(accumulator, curr.mesh);\n        }, { positions: [], tris: [] });\n        const unrolled = unrollArap(foo);\n        return new Assembly({\n            geometry: xysToClosedDrawing(unrolled.outline)\n        });\n    }\n    else {\n        //@ts-ignore\n        const result = toUnroll.map((leaf) => {\n            const unrollResult = unrollArap(leaf.mesh);\n            return new Assembly({\n                ...leaf.srcLeaf,\n                geometry: xysToClosedDrawing(unrollResult.outline)\n            });\n        });\n        return new Assembly({ geometry: result.flat() }).skipDisjointPostprocess();\n    }\n}\nfunction combineMeshs(m1, m2) {\n    console.log(`m1, position count: ${m1.positions.length} tris count: ${m1.tris.length}`);\n    console.log(`m2, position count: ${m2.positions.length} tris count: ${m2.tris.length}`);\n    const floatEq = (a, b) => {\n        return Math.abs(a - b) < 0.000001;\n    };\n    // find match points TODO this is deeply suboptimal. Esp if combineMeshs is called more than once.\n    const indexTuples = [];\n    m1.positions.forEach((point, index) => {\n        m2.positions.forEach((p2, i2) => {\n            if (floatEq(point.x, p2.x) && floatEq(point.y, p2.y) && floatEq(point.z, p2.z)) {\n                console.log('found a match');\n                indexTuples.push({ m1: index, m2: i2 });\n            }\n        });\n    });\n    console.log(indexTuples);\n    const shiftTris = m2.tris.map((tri) => {\n        return tri.map((pointIndex) => pointIndex += m1.positions.length);\n    });\n    // replace equivalent points from meshes\n    const dedupTris = shiftTris.map((tri) => {\n        return tri.map((pointIndex) => {\n            const unshift = pointIndex - m1.positions.length;\n            const i = indexTuples.map((f) => f.m2).indexOf(unshift);\n            if (i >= 0) {\n                return indexTuples[i].m1;\n            }\n            return pointIndex;\n        });\n    });\n    const res = {\n        positions: m1.positions.concat(m2.positions),\n        tris: m1.tris.concat(dedupTris)\n    };\n    console.log(`res, position count: ${res.positions.length} tris count: ${res.tris.length}`);\n    return res;\n}\nfunction faceToMesh(face) {\n    const replMesh = face.mesh();\n    // translate\n    const points = [];\n    const v = replMesh.vertices;\n    for (let i = 0; i < v.length; i += 3) {\n        points.push({ x: v[i], y: v[i + 1], z: v[i + 2] });\n    }\n    const tris = [];\n    const t = replMesh.triangles;\n    for (let i = 0; i < t.length; i += 3) {\n        tris.push([t[i], t[i + 1], t[i + 2]]);\n    }\n    return { positions: points, tris: tris };\n}\nfunction xysToClosedDrawing(points) {\n    const pen = replicad.draw([points[0].x, points[0].y]);\n    for (let i = 1; i < points.length; i++) {\n        pen.lineTo([points[i].x, points[i].y]);\n    }\n    return pen.close();\n}\nconst COT_MIN = 0.05;\nconst COT_MAX = 20;\nconst ITERATIONS = 4000;\nconst SETTLED = 1e-6;\nexport function unrollArap(mesh) {\n    const tris = buildTris(mesh);\n    const nv = mesh.positions.length;\n    const flat = placeByUnfol