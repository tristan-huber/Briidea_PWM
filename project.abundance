]].x - flat[ids[p]].x;\n            const dqy = flat[ids[q]].y - flat[ids[p]].y;\n            num += w * (dqy * dxc - dqx * dyc);\n            den += w * (dqx * dxc + dqy * dyc);\n        }\n        const th = Math.atan2(num, den);\n        cos[t] = Math.cos(th);\n        sin[t] = Math.sin(th);\n    });\n}\nfunction gaussSeidel(flat, adj, cos, sin, nv) {\n    let maxDelta = 0;\n    for (let sweep = 0; sweep < 3; sweep++) {\n        for (let i = 1; i < nv; i++) {\n            let diag = 0;\n            let sx = 0;\n            let sy = 0;\n            for (const e of adj[i]) {\n                diag += e.w;\n                sx += e.w * (flat[e.j].x + cos[e.t] * e.dx - sin[e.t] * e.dy);\n                sy += e.w * (flat[e.j].y + sin[e.t] * e.dx + cos[e.t] * e.dy);\n            }\n            if (diag <= 0)\n                continue;\n            const nx = sx / diag;\n            const ny = sy / diag;\n            const d = Math.hypot(nx - flat[i].x, ny - flat[i].y);\n            if (d > maxDelta)\n                maxDelta = d;\n            flat[i] = { x: nx, y: ny };\n        }\n    }\n    return maxDelta;\n}\nfunction factorSystem(adj, nv) {\n    const n = nv - 1;\n    if (n <= 0)\n        return null;\n    let b = 0;\n    for (let i = 1; i < nv; i++) {\n        for (const e of adj[i]) {\n            if (e.j === 0)\n                continue;\n            const d = Math.abs(i - e.j);\n            if (d > b)\n                b = d;\n        }\n    }\n    if (b >= n)\n        return null;\n    const a = new Float64Array(n * (b + 1));\n    for (let i = 1; i < nv; i++) {\n        const r = i - 1;\n        for (const e of adj[i]) {\n            a[r * (b + 1)] += e.w;\n            if (e.j === 0)\n                continue;\n            const c = e.j - 1;\n            if (c < r)\n                a[r * (b + 1) + (r - c)] -= e.w;\n        }\n    }\n    const envelope = new Int32Array(n);\n    for (let r = 0; r < n; r++) {\n        const top = Math.min(b, r);\n        for (let k = top; k >= 1; k--) {\n            if (a[r * (b + 1) + k] !== 0) {\n                envelope[r] = k;\n                break;\n            }\n        }\n    }\n    for (let i = 0; i < n; i++) {\n        const wi = envelope[i];\n        for (let k = wi; k >= 1; k--) {\n            const j = i - k;\n            if (j < 0)\n                continue;\n            let s = a[i * (b + 1) + k];\n            const top = Math.min(wi - k, envelope[j]);\n            for (let m = 1; m <= top; m++) {\n                s -= a[i * (b + 1) + (k + m)] * a[j * (b + 1) + m];\n            }\n            a[i * (b + 1) + k] = s / a[j * (b + 1)];\n        }\n        let d = a[i * (b + 1)];\n        for (let k = 1; k <= wi; k++) {\n            d -= a[i * (b + 1) + k] * a[i * (b + 1) + k];\n        }\n        if (!(d > 0))\n            return null;\n        a[i * (b + 1)] = Math.sqrt(d);\n    }\n    return { n, b, a, envelope };\n}\nfunction solveBanded(m, rx, ry) {\n    const { n, b, a, envelope } = m;\n    const w = b + 1;\n    for (let i = 0; i < n; i++) {\n        let sx = rx[i];\n        let sy = ry[i];\n        const wi = envelope[i];\n        for (let k = 1; k <= wi; k++) {\n            const v = a[i * w + k];\n            sx -= v * rx[i - k];\n            sy -= v * ry[i - k];\n        }\n        const d = a[i * w];\n        rx[i] = sx / d;\n        ry[i] = sy / d;\n    }\n    for (let i = n - 1; i >= 0; i--) {\n        const d = a[i * w];\n        const vx = rx[i] / d;\n        const vy = ry[i] / d;\n        rx[i] = vx;\n        ry[i] = vy;\n        const wi = envelope[i];\n        for (let k = 1; k <= wi; k++) {\n            const v = a[i * w + k];\n            rx[i - k] -= v * vx;\n            ry[i - k] -= v * vy;\n        }\n    }\n}\nfunction intrinsicScale(tris) {\n    let area = 0;\n    for (const tri of tris)\n        area += tri.area;\n    return area > 0 ? Math.sqrt(area) : 1;\n}\nexport function buildTris(mesh) {\n    const out = [];\n    for (const [a, b, c] of mesh.tris) {\n        const A = mesh.positions[a];\n        const B = mesh.positions[b];\n        const C = mesh.positions[c];\n        const ux = B.x - A.x, uy = B.y - A.y, uz = B.z - A.z;\n        const vx = C.x - A.x, vy = C.y - A.y, vz = C.z - A.z;\n        const cx = uy * vz - uz * vy;\n        const cy = uz * vx - ux * vz;\n        const cz = ux * vy - uy * vx;\n        const cross = Math.hypot(cx, cy, cz);\n        const la = Math.hypot(ux, uy, uz);\n        const lb = Math.hypot(vx, vy, vz);\n        if (la === 0 || lb === 0)\n            continue;\n        const cos = Math.max(-1, Math.min(1, (ux * vx + uy * vy + uz * vz) / (la * lb)));\n        out.push({\n            ids: [a, b, c],\n            xs: [\n                { x: 0, y: 0 },\n                { x: la, y: 0 },\n                { x: lb * cos, y: lb * Math.sqrt(Math.max(0, 1 - cos * cos)) },\n            ],\n            area: cross / 2,\n        });\n    }\n    return out;\n}\nexport function energyOf(flat, tris) {\n    let e = 0;\n    let area = 0;\n    for (const tri of tris) {\n        const { ids, xs } = tri;\n        for (let k = 0; k < 3; k++) {\n            const p = k;\n            const q = (k + 1) % 3;\n            const lc = Math.hypot(xs[q].x - xs[p].x, xs[q].y - xs[p].y);\n            const lq = Math.hypot(flat[ids[q]].x - flat[ids[p]].x, flat[ids[q]].y - flat[ids[p]].y);\n            e += (lq - lc) * (lq - lc);\n        }\n        area += tri.area;\n    }\n    return area > 0 ? e / area : 0;\n}\nexport function placeByUnfolding(mesh, tris) {\n    const nv = mesh.positions.length;\n    const flat = new Array(nv);\n    const placed = new Array(nv).fill(false);\n    const incident = [];\n    for (let i = 0; i < nv; i++)\n        incident.push([]);\n    tris.forEach((tri, t) => {\n        for (const id of tri.ids)\n            incident[id].push(t);\n    });\n    const seed = tris[0];\n    seed.ids.forEach((id, k) => {\n        flat[id] = { x: seed.xs[k].x, y: seed.xs[k].y };\n        placed[id] = true;\n    });\n    const queue = seed.ids.flatMap((id) => incident[id]);\n    for (let head = 0; head < queue.length; head++) {\n        const tri = tris[queue[head]];\n        const open = tri.ids.filter((i) => !placed[i]);\n        if (open.length !== 1)\n            continue;\n        const v = open[0];\n        const p = placeFrom(bestHinge(v, incident[v], tris, placed, tri), v, flat, placed);\n        if (!p)\n            continue;\n        flat[v] = p;\n        placed[v] = true;\n        for (const t of incident[v])\n            queue.push(t);\n    }\n    for (let i = 0; i < nv; i++) {\n        if (!placed[i])\n            console.warn(`unroll: vertex ${i} of ${nv} is not connected to the mesh`);\n    }\n    return flat;\n}\nfunction bestHinge(v, candidates, tris, placed, fallback) {\n    let best = fallback;\n    let bestScore = -Infinity;\n    for (const t of candidates) {\n        const tri = tris[t];\n        const k = tri.ids.indexOf(v);\n        if (k < 0)\n            continue;\n        const i = (k + 1) % 3;\n        const j = (k + 2) % 3;\n        if (!placed[tri.ids[i]] || !placed[tri.ids[j]])\n            continue;\n        const edge = sq(tri.xs[j].x - tri.xs[i].x, tri.xs[j].y - tri.xs[i].y);\n        const reach = sq(tri.xs[k].x - tri.xs[i].x, tri.xs[k].y - tri.xs[i].y);\n        const score = reach > 0 ? edge / reach : Infinity;\n        if (score > bestScore) {\n            bestScore = score;\n            best = tri;\n        }\n    }\n    return best;\n}\nfunction sq(dx, dy) {\n    return dx * dx + dy * dy;\n}\nfunction placeFrom(tri, v, flat, placed) {\n    const { ids, xs } = tri;\n    const k = ids.indexOf(v);\n    const i = (k + 1) % 3;\n    const j = (k + 2) % 3;\n    if (!placed[ids[i]] || !placed[ids[j]])\n        return null;\n    const dx = xs[j].x - xs[i].x;\n    const dy = xs[j].y - xs[i].y;\n    const den = dx * dx + dy * dy;\n    if (den < 1e-12)\n        return null;\n    const ex = flat[ids[j]].x - flat[ids[i]].x;\n    const ey = flat[ids[j]].y - flat[ids[i]].y;\n    const sr = (ex * dx + ey * dy) / den;\n    const si = (ey * dx - ex * dy) / den;\n    const norm = Math.hypot(sr, si);\n    if (norm < 1e-12)\n        return null;\n    const cr = sr / norm;\n    const ci = si / norm;\n    const vx = xs[k].x - xs[i].x;\n    const vy = xs[k].y - xs[i].y;\n    return {\n        x: flat[ids[i]].x + cr * vx - ci * vy,\n        y: flat[ids[i]].y + ci * vx + cr * vy,\n    };\n}\nexport function canonicalise(flat) {\n    if (flat.length === 0)\n        return flat;\n    let cx = 0;\n    let cy = 0;\n    for (const p of flat) {\n        cx += p.x;\n        cy += p.y;\n    }\n    cx /= flat.length;\n    cy /= flat.length;\n    let sxx = 0;\n    let sxy = 0;\n    let syy = 0;\n    for (const p of flat) {\n        const dx = p.x - cx;\n        const dy = p.y - cy;\n        sxx += dx * dx;\n        sxy += dx * dy;\n        syy += dy * dy;\n    }\n    const ang = 0.5 * Math.atan2(2 * sxy, sxx - syy);\n    const co = Math.cos(-ang);\n    const si = Math.sin(-ang);\n    let minX = Infinity;\n    let minY = Infinity;\n    const out = flat.map((p) => {\n        const dx = p.x - cx;\n        const dy = p.y - cy;\n        const q = { x: co * dx - si * dy, y: si * dx + co * dy };\n        if (q.x < minX)\n            minX = q.x;\n        if (q.y < minY)\n            minY = q.y;\n        return q;\n    });\n    for (const q of out) {\n        q.x -= minX;\n        q.y -= minY;\n    }\n    return out;\n}\nexport function boundaryEdges(mesh) {\n    const used = new Map();\n    const key = (a, b) => (a < b ? `${a}-${b}` : `${b}-${a}`);\n    for (const [a, b, c] of mesh.tris) {\n        for (const [u, v] of [[a, b], [b, c], [c, a]]) {\n            used.set(key(u, v), (used.get(key(u, v)) ?? 0) + 1);\n        }\n    }\n    const out = [];\n    for (const [a, b, c] of mesh.tris) {\n        for (const [u, v] of [[a, b], [b, c], [c, a]]) {\n            if (used.get(key(u, v)) === 1)\n                out.push([u, v]);\n       